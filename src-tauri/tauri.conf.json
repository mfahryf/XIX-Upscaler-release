{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XIX-Upscaler",
  "version": "0.1.3",
  "identifier": "net.xixlabs.upscaler",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "XIX-Upscaler",
        "width": 300,
        "height": 600,
        "minWidth": 300,
        "maxWidth": 300,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [],
    "resources": ["tor-runtime/", "models/", "ffmpeg-runtime/"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY2NDJBMkZDMzMzQTlEMkMKUldRc25Ub3ovS0pDOXB4b3J5MGFKYUhRbWdQWUxJc2VKdlMxZnJWOUt2NkRVYVlhN01lNEtSNEkK",
      "endpoints": [
        "https://github.com/mfahryf/XIX-Upscaler-release/releases/latest/download/latest.json"
      ]
    }
  }
}
